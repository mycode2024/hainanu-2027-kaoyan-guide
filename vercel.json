{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; connect-src 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:endpoint", "destination": "/api/index?endpoint=:endpoint" },
    { "source": "/programs", "destination": "/programs.html" },
    { "source": "/scores", "destination": "/scores.html" },
    { "source": "/preparation", "destination": "/preparation.html" },
    { "source": "/timeline", "destination": "/timeline.html" },
    { "source": "/application", "destination": "/application.html" },
    { "source": "/materials", "destination": "/materials.html" },
    { "source": "/updates", "destination": "/updates.html" },
    { "source": "/sources", "destination": "/sources.html" }
  ]
}
